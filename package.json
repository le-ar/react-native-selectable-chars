{
  "name": "react-native-select-chars",
  "version": "2.0.0",
  "description": "Native, scrollable text selection with React Native menus and persistent highlights",
  "homepage": "https://github.com/le-ar/react-native-selectable-chars",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/le-ar/react-native-selectable-chars.git"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "react-native": "src/index.tsx",
  "source": "src/index.tsx",
  "author": "Andrei <malmuk2013@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.4"
  },
  "packageManager": "pnpm@10.28.2",
  "files": [
    "android",
    "ios",
    "src",
    "lib",
    "react-native-select-chars.podspec",
    "!src/__tests__",
    "!android/build",
    "!android/src/test",
    "!ios/Tests",
    "!ios/tests",
    "!**/.DS_Store",
    "!**/.gradle",
    "!**/build"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "compile": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src example/src --ext .ts,.tsx",
    "prepare": "npm run build",
    "test": "jest --runInBand",
    "codegen": "node node_modules/react-native/scripts/generate-codegen-artifacts.js -p . -o .generated -t all"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@react-native/babel-preset": "0.85.3",
    "@react-native/eslint-config": "0.85.3",
    "@react-native/jest-preset": "0.85.3",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-jest": "^29.7.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "prettier": "^3.6.0",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "react": ">=19.2.3",
    "react-native": ">=0.85.0"
  },
  "codegenConfig": {
    "name": "RNSelectCharsSpec",
    "type": "components",
    "jsSrcsDir": "src/specs",
    "android": {
      "javaPackageName": "com.andrei.reactnativeselectchars"
    },
    "ios": {
      "componentProvider": {
        "RNSelectCharsView": "RNSelectCharsView"
      }
    }
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "transformIgnorePatterns": [
      "node_modules/(?!(\\.pnpm/)?(@react-native|react-native))"
    ],
    "testMatch": [
      "<rootDir>/src/__tests__/**/*.test.[jt]s?(x)"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ]
  }
}
